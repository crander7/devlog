{
    "compilerOptions": {
        "composite": true,
        "skipLibCheck": true,
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "allowSyntheticDefaultImports": true,
        "strict": true,
        "types": ["bun-types"]
    },
    "include": [
        "vite.config.ts",
        "electrobun.config.ts",
        "src/bun",
        "src/shared"
    ]
}
